@model dynamic
@{
    ViewData["Title"] = "Корзина";
}

<h2>Ваша корзина</h2>

@if (Model.Count == 0)
{
    <p>Корзина пуста.</p>
    <a asp-controller="Tools" asp-action="Index" class="btn btn-primary">Перейти в каталог</a>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Инструмент</th>
                <th>Цена</th>
                <th>Кол-во</th>
                <th>Сумма</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Tool.Name</td>
                    <td>@item.Tool.Price</td>
                    <td>@item.Quantity</td>
                    <td>@(item.Tool.Price * item.Quantity)</td>
                    <td>
                        <form asp-action="Remove" method="post" asp-route-id="@item.Tool.Id">
                            <button type="submit" class="btn btn-danger btn-sm">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    
    <h4>Итого: @ViewBag.TotalSum руб.</h4>

    <form asp-action="Checkout" method="post" class="mt-3">
        <div class="form-group mb-2">
            <label>Адрес доставки:</label>
            <input type="text" name="deliveryAddress" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-success">Оформить заказ</button>
    </form>
}