@model ToolStore.Models.Manufacturer

@{
    ViewData["Title"] = "Удалить производителя";
}

<h1>Удалить производителя</h1>

<h3>Вы уверены, что хотите удалить этого производителя?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Название</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Name)</dd>
        
        <dt class="col-sm-2">Страна</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Country)</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Удалить" class="btn btn-danger" /> |
        <a asp-action="Index">Вернуться к списку</a>
    </form>
</div>
