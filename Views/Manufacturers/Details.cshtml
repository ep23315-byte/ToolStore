@model ToolStore.Models.Manufacturer

@{
    ViewData["Title"] = "Детали производителя";
}

<h1>Детали производителя</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Название</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Name)</dd>
        
        <dt class="col-sm-2">Страна</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Country)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">Редактировать</a> |
    <a asp-action="Index">Вернуться к списку</a>
</div>
