@model IEnumerable<ToolStore.Models.Order>
@{
    ViewData["Title"] = "Управление заказами";
}

<h2>Управление заказами</h2>

<table class="table">
    <thead>
        <tr>
            <th>Дата</th>
            <th>Адрес доставки</th>
            <th>Товары</th>
            <th>Статус</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.Date.ToString("g")</td>
                <td>@order.DeliveryAddress</td>
                <td>
                    <ul>
                        @foreach (var item in order.OrderItems)
                        {
                            <li>@item.Tool.Name (x @item.Quantity)</li>
                        }
                    </ul>
                </td>
                <td>
                    <span class="badge @(order.Status == "Оплачен" ? "bg-success" : (order.Status == "Отменен" ? "bg-danger" : "bg-primary"))">
                        @order.Status
                    </span>
                </td>
                <td>
                    @if (order.Status != "Оплачен" && order.Status != "Отменен")
                    {
                        <form asp-action="ChangeStatus" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@order.Id" />
                            <input type="hidden" name="newStatus" value="Подтвержден" />
                            <button type="submit" class="btn btn-info btn-sm">Подтвердить</button>
                        </form>

                        <form asp-action="ChangeStatus" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@order.Id" />
                            <input type="hidden" name="newStatus" value="Оплачен" />
                            <button type="submit" class="btn btn-success btn-sm">Оплатить</button>
                        </form>
                    }
                    
                    @if (order.Status == "Оформлен" || order.Status == "Подтвержден")
                    {
                        <form asp-action="ChangeStatus" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@order.Id" />
                            <input type="hidden" name="newStatus" value="Отменен" />
                            <button type="submit" class="btn btn-danger btn-sm">Отменить</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>