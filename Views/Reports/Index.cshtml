@model IEnumerable<ToolStore.Models.Order>
@{
    ViewData["Title"] = "Отчет по продажам";
}

<h2>Отчет по продажам за период</h2>

<form method="get" class="mb-4 row g-3 align-items-end">
    <div class="col-auto">
        <label class="form-label">С даты:</label>
        <input type="date" name="startDate" class="form-control" value="@ViewBag.StartDate" required />
    </div>
    <div class="col-auto">
        <label class="form-label">По дату:</label>
        <input type="date" name="endDate" class="form-control" value="@ViewBag.EndDate" required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Показать отчет</button>
    </div>
</form>

<div class="alert alert-info">
    <strong>Общая выручка за период:</strong> @ViewBag.TotalSum руб.
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>№ Заказа</th>
            <th>Дата</th>
            <th>Заказчик</th>
            <th>Состав заказа</th>
            <th>Статус</th>
            <th>Сумма</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center">За выбранный период заказов не найдено.</td>
            </tr>
        }
        else
        {
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>@order.Date.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@(order.User?.Name ?? "Неизвестный")</td>
                    <td>
                        <ul class="mb-0">
                            @foreach (var item in order.OrderItems)
                            {
                                <li>@item.Tool.Name (x @item.Quantity) — @(item.Tool.Price * item.Quantity) руб.</li>
                            }
                        </ul>
                    </td>
                    <td>@order.Status</td>
                    <td>
                        @order.OrderItems.Sum(oi => oi.Tool.Price * oi.Quantity) руб.
                    </td>
                </tr>
            }
        }
    </tbody>
</table>