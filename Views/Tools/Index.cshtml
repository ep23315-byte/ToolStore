@model IEnumerable<ToolStore.Models.Tool>

@{
    ViewData["Title"] = "Каталог инструментов";
}

<h1>Каталог инструментов</h1>

<p>
    @if (Context.Session.GetString("UserRole") == "Менеджер")
    {
        <p>
            <a asp-action="Create" class="btn btn-primary">Добавить новый инструмент</a>
        </p>
    }
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Название</th>
            <th>Цена</th>
            <th>Остаток на складе</th>
            <th>Производитель</th>
            <th>Область применения</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Price)
                </td>
                <td>
                    @Html.DisplayFor(model => item.QuantityInStock)
                </td>
                <td>
                    @(item.Manufacturer?.Name ?? "Не указан")
                </td>
                <td>
                    @(item.ApplicationArea?.Name ?? "Не указана")
                </td>
                <td>
                    <form asp-controller="Cart" asp-action="Add" asp-route-id="@item.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-success btn-sm mb-1">В корзину</button>
                    </form>
                
                    @if (Context.Session.GetString("UserRole") == "Менеджер")
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm mb-1">Изменить</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm mb-1">Детали</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm mb-1">Удалить</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>